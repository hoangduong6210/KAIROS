__pycache__/
*.py[cod]
*.egg-info/
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
build/
dist/
runs/
kairos-benchmark-v1-*.out
kairos-benchmark-v1-*.err
*.partial
.internal/

# Public Git keeps only archive/release boundary documentation.
archive/**
!archive/README.md
releases/**
!releases/README.md
docs/reports/**
results/historical/legacy-bundle/**
!results/historical/legacy-bundle/README.md
!results/historical/legacy-bundle/checksums.sha256

# Local or mutable data. Public Git retains metadata and checksums, not bytes.
!datasets/
!datasets/README.md
!datasets/RIGHTS.md
!datasets/checksums.sha256
!datasets/raw/
!datasets/processed/
datasets/raw/*.csv
datasets/processed/*.csv
datasets/external/
datasets/cache/
datasets/processed/*.parquet

# LaTeX intermediates; source and intentional PDFs remain versioned.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
/paper/snapshots/kairos-conference-final/main.pdf
